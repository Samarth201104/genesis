# Copy this file to .env.local and adjust for local development.
# .env.local is gitignored (see *.local in the root .gitignore) — never
# commit real local overrides here.

# Backend API base URL. Leave unset to use the deployed Render backend
# (https://genesis-wvjj.onrender.com), or point at your local Flask
# server (usually http://localhost:5000) while running both halves locally.
VITE_API_BASE=http://localhost:5000
